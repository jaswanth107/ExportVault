# ---------------------------------------------------------------------------
# ExportVault environment configuration
# Copy to .env and fill in. NEVER commit a real .env file.
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# Port the Express API listens on
PORT=5000

# PostgreSQL connection string (PostgreSQL 16).
# Local docker compose default shown below.
DATABASE_URL=postgresql://exportvault:exportvault@localhost:5435/exportvault?schema=public

# Redis connection used by BullMQ for the export queue.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
# Set to 1 when the managed Redis provider requires TLS (e.g. Upstash).
REDIS_TLS=0

# Secret used to sign JWTs. Must be >= 32 chars. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# JWT lifetime
JWT_EXPIRES_IN=12h

# ---------------------------------------------------------------------------
# S3-compatible object storage (Cloudflare R2 / AWS S3 / MinIO)
# Export CSV files are NEVER kept permanently on backend local disk.
# ---------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=exportvault
AWS_SECRET_ACCESS_KEY=exportvault-secret
AWS_REGION=auto

S3_BUCKET=exportvault
# Leave empty for real AWS S3. Set for MinIO / Cloudflare R2.
S3_ENDPOINT=http://localhost:9100
# Endpoint embedded in presigned download URLs. Leave EMPTY for AWS S3 and
# Cloudflare R2 (the API and the browser use the same host). Set it only when
# the API reaches storage over an internal address the browser cannot resolve,
# as inside docker compose.
S3_PUBLIC_ENDPOINT=

# MinIO and R2 both require path-style addressing.
S3_FORCE_PATH_STYLE=1
# Lifetime (seconds) of presigned CSV download URLs
S3_SIGNED_URL_TTL=900
# Send response-content-disposition/type on presigned GETs so the browser saves
# the file as an attachment. AWS S3, Cloudflare R2 and MinIO support this;
# Supabase Storage does NOT — set this to 0 there.
S3_RESPONSE_OVERRIDES=1

# Comma-separated CORS allowlist for the browser client.
CLIENT_URL=http://localhost:5173

# Structured logging level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Number of export batches a worker processes concurrently (jobs, not batches).
WORKER_CONCURRENCY=2
# When set, the worker also serves GET /health (queue depth + dependency state).
# Required on hosts that only run port-binding services — Render's free tier has
# no background-worker type. Leave empty for a normal worker deployment.
WORKER_HEALTH_PORT=
# Rows fetched + written per batch/checkpoint.
EXPORT_BATCH_SIZE=1000
# A RUNNING job whose updated_at is older than this many seconds is considered
# dead (its worker crashed) and is swept to INTERRUPTED.
EXPORT_STALL_TIMEOUT_SECONDS=45

# Test-only fault injection. When set, the worker exits(1) hard after it has
# exported at least this many rows. Used by the interruption test.
# Leave EMPTY in production.
EXPORT_CRASH_AFTER_ROWS=
